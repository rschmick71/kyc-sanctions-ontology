# =============================================================================
#  KSO Jurisdictions — the 20-jurisdiction matrix as linked data.
#
#  Transcribed from docs/architecture/lines-of-defence-operating-model.md, §5.
#  FATF statuses change several times a year (February / June / October
#  plenaries). Before relying on a status, verify it against the current FATF
#  publication and bump dcterms:modified below.
# =============================================================================

@prefix kso:     <https://w3id.org/kso/ontology#> .
@prefix ksov:    <https://w3id.org/kso/vocab#> .
@prefix ksoj:    <https://w3id.org/kso/jurisdiction/> .
@prefix ksod:    <https://w3id.org/kso/local-document/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

ksoj:JurisdictionScheme a skos:ConceptScheme ;
    skos:prefLabel "KSO jurisdictions"@en ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    skos:scopeNote "FATF status and risk tier are point-in-time assertions from the operating-model matrix; re-verify each FATF plenary."@en .

ksod:LocalDocumentScheme a skos:ConceptScheme ;
    skos:prefLabel "Local supplemental document types"@en .

# --- United States ---------------------------------------------------------------
ksoj:US a kso:Jurisdiction , skos:Concept ;
    skos:inScheme ksoj:JurisdictionScheme ;
    skos:prefLabel "United States"@en ;
    kso:isoCountryCode "US" ;
    kso:primaryRegulator "OCC / FinCEN" ;
    kso:hasFatfStatus ksov:FatfStandard ;
    kso:hasRiskTier ksov:RiskLowMedium ;
    kso:requiresDocument ksod:US-FincenCddForm , ksod:US-StateRegistryCertificate , ksod:US-FormW9 .
ksod:US-FincenCddForm a skos:Concept ; skos:inScheme ksod:LocalDocumentScheme ; skos:prefLabel "FinCEN CDD Form"@en .
ksod:US-StateRegistryCertificate a skos:Concept ; skos:inScheme ksod:LocalDocumentScheme ; skos:prefLabel "State Registry Certificate"@en .
ksod:US-FormW9 a skos:Concept ; skos:inScheme ksod:LocalDocumentScheme ; skos:prefLabel "Form W-9"@en .

# --- United Kingdom ---------------------------------------------------------------
ksoj:GB a kso:Jurisdiction , skos:Concept ;
    skos:inScheme ksoj:JurisdictionScheme ;
    skos:prefLabel "United Kingdom"@en ;
    kso:isoCountryCode "GB" ;
    kso:primaryRegulator "FCA / HM Treasury" ;
    kso:hasFatfStatus ksov:FatfStandard ;
    kso:hasRiskTier ksov:RiskLow ;
    kso:requiresDocument ksod:GB-CompaniesHouseExtract , ksod:GB-PscRegister .
ksod:GB-CompaniesHouseExtract a skos:Concept ; skos:inScheme ksod:LocalDocumentScheme ; skos:prefLabel "Companies House Extract"@en .
ksod:GB-PscRegister a skos:Concept ; skos:inScheme ksod:LocalDocumentScheme ; skos:prefLabel "PSC Register"@en .

# --- Singapore ---------------------------------------------------------------
