    kso:isoCountryCode "SG" ;
    kso:primaryRegulator "MAS" ;
    kso:hasFatfStatus ksov:FatfStandard ;
    kso:hasRiskTier ksov:RiskLow ;
    kso:requiresDocument ksod:SG-AcraBizfileExtract , ksod:SG-LocalResidentDirectorVerification .
ksod:SG-AcraBizfileExtract a skos:Concept ; skos:inScheme ksod:LocalDocumentScheme ; skos:prefLabel "ACRA BizFile Extract"@en .
ksod:SG-LocalResidentDirectorVerification a skos:Concept ; skos:inScheme ksod:LocalDocumentScheme ; skos:prefLabel "Local Resident Director Verification"@en .

