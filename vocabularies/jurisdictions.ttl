    skos:prefLabel "Kenya"@en ;
    kso:isoCountryCode "KE" ;
    kso:primaryRegulator "CBK" ;
    kso:hasFatfStatus ksov:FatfIncreasedMonitoring ;
    kso:hasRiskTier ksov:RiskHigh ;
    kso:requiresDocument ksod:KE-KraPinCertificate , ksod:KE-FormCr12DirectorsRegistry .
ksod:KE-KraPinCertificate a skos:Concept ; skos:inScheme ksod:LocalDocumentScheme ; skos:prefLabel "KRA PIN Certificate"@en .
ksod:KE-FormCr12DirectorsRegistry a skos:Concept ; skos:inScheme ksod:LocalDocumentScheme ; skos:prefLabel "Form CR12 Directors Registry"@en .

